# 站点原有计数功能及可选 AI 摘要使用的 Upstash REST 凭据。
# 启用 AI 时必须提供。摘要记录不设置 TTL；必须在 Upstash 关闭 Eviction。
# 不使用只读 Token 生成摘要；凭据不得带 NEXT_PUBLIC_ 前缀。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选 AI 接入；mode/提示词/失败策略统一在 site.config.js 配置。
# auto 模式下 Key 为空：普通正文摘录，无模型调用、无摘要数据库读写。
# API Key：在 Vercel 环境变量或本地 .env.local 中填写，勿提交实际值。
OPENAI_API_KEY=
# HTTPS Chat Completions 基础地址，包含版本路径；默认官方 /v1。
OPENAI_BASE_URL=https://api.openai.com/v1
# AI 启用时必填；必须是服务商实际支持的文本模型名称。
OPENAI_MODEL=

# 可选的网站访问分析设置，与 AI 无关。
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

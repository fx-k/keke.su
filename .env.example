# 站点计数功能及可选 AI 摘要使用的 Upstash REST 凭据。
# 启用 AI 时必须提供；摘要无 TTL，数据库须关闭 Eviction 并安排备份。
# 生成摘要需要读写 Token；凭据不得使用 NEXT_PUBLIC_ 前缀。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 模式、文风和失败策略统一在 site.config.js 的 ai_desc_gen 中配置。
# auto 未配置 Key：正常使用正文摘录；有 Key：AI 失败按照 onAIError 处理。
# API Key：填写到 Vercel 环境变量或本地 .env.local，勿提交实际值。
OPENAI_API_KEY=
# HTTPS Chat Completions 基础地址，包含版本路径；默认官方 /v1。
OPENAI_BASE_URL=https://api.openai.com/v1
# AI 启用时必填；使用服务商实际支持的文本模型名称。
OPENAI_MODEL=

# 可选的网站访问分析设置，与 AI 无关。
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
